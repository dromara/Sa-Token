	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>compile-coverage-summary</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/coverage-summary/java</compileSourceRoot>
							</compileSourceRoots>
							<outputDirectory>${project.build.directory}/coverage-summary-classes</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report-aggregate</id>
						<phase>test</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>jacoco-coverage-summary</id>
						<phase>test</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>${coverage.summary.mainClass}</mainClass>
							<additionalClasspathElements>
								<additionalClasspathElement>${project.build.directory}/coverage-summary-classes</additionalClasspathElement>
							</additionalClasspathElements>
							<arguments>
								<argument>${project.build.directory}/site/jacoco-aggregate/jacoco.csv</argument>
								<argument>${project.build.directory}/site/jacoco-aggregate/coverage-summary.html</argument>
								<argument>Sa-Token Aggregate Coverage</argument>
								<argument>index.html</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
